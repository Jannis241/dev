{
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "height": 34,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "custom/power"],

    "hyprland/workspaces": {
        "format": "{name}"
    },

    "network": {
        "format-wifi": "󰤨  {signalStrength}%",
        "format-ethernet": "󰈀  LAN",
        "format-linked": "󰌙  LINK",
        "format-disconnected": "󰤭  OFF",
        "tooltip-format-wifi": "{essid}",
        "tooltip": true
    },

    "cpu": {
        "interval": 2,
        "format": "  {usage}%"
    },

    "memory": {
        "interval": 2,
        "format": "  {percentage}%"
    },

    "battery": {
        "states": {
            "good": 85,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-plugged": "󰂄  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  MUT",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a %d.%m.}",
        "on-click": "swaync-client -t -sw"
    },

    "custom/power": {
        "tooltip": false,
        "on-click": "wlogout &",
        "format": "⏻"
    }
}
