{
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "height": 28,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": [],
    "modules-right": ["network", "battery", "pulseaudio", "clock", "custom/power"],

    "hyprland/workspaces": {
        "format": "{name}"
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-linked": "",
        "format-disconnected": "",
        "tooltip-format-wifi": "{essid}",
        "tooltip": true
    },

    "battery": {
        "states": {
            "good": 85,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-plugged": " {capacity}%",
        "format-charging": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a %d.%m.}",
        "on-click": "swaync-client -t -sw"
    },

    "custom/power": {
        "tooltip": false,
        "on-click": "wlogout &",
        "format": "⏻"
    }
}
