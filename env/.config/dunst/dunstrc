[global]
    monitor = 0
    follow = none
    width = 330
    height = (0, 180)
    origin = top-right
    offset = (12, 44)
    notification_limit = 5

    font = JetBrainsMono Nerd Font 10
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    markup = full
    ellipsize = end
    show_age_threshold = -1
    ignore_newline = no
    word_wrap = yes

    padding = 10
    horizontal_padding = 12
    text_icon_padding = 10
    frame_width = 1
    frame_color = "#253340"
    separator_height = 0
    gap_size = 8
    corner_radius = 10

    icon_position = left
    min_icon_size = 28
    max_icon_size = 48
    enable_recursive_icon_lookup = true
    icon_theme = Adwaita

    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 180
    progress_bar_max_width = 330
    progress_bar_corner_radius = 2

    stack_duplicates = true
    hide_duplicate_count = false
    history_length = 20
    sticky_history = yes
    show_indicators = no
    sort = update
    browser = /usr/bin/xdg-open

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#0f1419"
    foreground = "#5c6773"
    timeout = 4

[urgency_normal]
    background = "#0f1419"
    foreground = "#e6e1cf"
    timeout = 6

[urgency_critical]
    background = "#0f1419"
    foreground = "#e6e1cf"
    frame_color = "#f07178"
    timeout = 0

