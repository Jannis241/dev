font-family = SF Mono Bold
font-size = 25

background = #1e1e1e

cursor-color = #bfbfbf
foreground = #ffffff

selection-background = #4d4d4d

palette = 0=#000000
palette = 1=#990000
palette = 2=#00a600
palette = 3=#999900
palette = 4=#0000b2
palette = 5=#b200b2
palette = 6=#00a6b2
palette = 7=#bfbfbf

palette = 8=#666666
palette = 9=#e50000
palette = 10=#00d900
palette = 11=#e5e500
palette = 12=#0000ff
palette = 13=#e500e5
palette = 14=#00e5e5
palette = 15=#ffffff

window-decoration = auto
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
cursor-style-blink = false

shell-integration-features = no-cursor,no-sudo,no-title
gtk-titlebar = false

keybind = ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
macos-option-as-alt = true
