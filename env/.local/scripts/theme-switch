#!/usr/bin/env bash
set -euo pipefail

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
themes_file="$config_home/theme-switcher/themes.tsv"
current_file="$state_home/theme-switcher/current"
nvim_state_file="$state_home/nvim/jannis-theme"

quiet=0
list_only=0
use_current=0
write_nvim_state=1
theme_name=""

usage() {
    cat <<'EOF'
Usage: theme-switch [THEME] [--current] [--list] [--quiet] [--no-nvim-state]

Without THEME, theme-switch opens rofi or fzf when available.
Theme data lives in ~/.config/theme-switcher/themes.tsv.
EOF
}

log() {
    if [[ "$quiet" -eq 0 ]]; then
        printf '%s\n' "$*"
    fi
}

theme_names() {
    awk -F '\t' 'NF && $1 !~ /^#/ { print $1 }' "$themes_file"
}

pick_theme() {
    if command -v rofi >/dev/null 2>&1; then
        theme_names | rofi -dmenu -p "Theme"
    elif command -v fzf >/dev/null 2>&1; then
        theme_names | fzf --prompt="Theme> "
    else
        usage >&2
        exit 2
    fi
}

load_theme() {
    local wanted="$1"

    while IFS=$'\t' read -r name nvim ghostty background background2 foreground select pink purple red orange yellow green blue gray; do
        [[ -z "${name:-}" || "${name:0:1}" == "#" ]] && continue
        if [[ "$name" == "$wanted" ]]; then
            THEME_NAME="$name"
            NVIM_THEME="$nvim"
            GHOSTTY_THEME="$ghostty"
            BACKGROUND="$background"
            BACKGROUND2="$background2"
            FOREGROUND="$foreground"
            SELECT="$select"
            PINK="$pink"
            PURPLE="$purple"
            RED="$red"
            ORANGE="$orange"
            YELLOW="$yellow"
            GREEN="$green"
            BLUE="$blue"
            GRAY="$gray"
            return 0
        fi
    done < "$themes_file"

    return 1
}

write_gtk_colors() {
    local output="$config_home/colors/colors.css"

    mkdir -p -- "$(dirname "$output")"
    cat > "$output" <<EOF
/* Generated by theme-switch. Edit theme-switcher/themes.tsv instead. */
@define-color background $BACKGROUND;
@define-color background2 $BACKGROUND2;
@define-color foreground $FOREGROUND;
@define-color select     $SELECT;

@define-color pink       $PINK;
@define-color purple     $PURPLE;
@define-color red        $RED;
@define-color orange     $ORANGE;
@define-color yellow     $YELLOW;
@define-color green      $GREEN;
@define-color blue       $BLUE;
@define-color gray       $GRAY;
EOF
}

write_rofi_colors() {
    local output="$config_home/colors/colors.rasi"

    mkdir -p -- "$(dirname "$output")"
    cat > "$output" <<EOF
/* Generated by theme-switch. Edit theme-switcher/themes.tsv instead. */
* {
    background: $BACKGROUND;
    foreground: $FOREGROUND;
    select: $SELECT;

    pink: $PINK;
    purple: $PURPLE;
    red: $RED;
    orange: $ORANGE;
    yellow: $YELLOW;
    green: $GREEN;
    blue: $BLUE;
    gray: $GRAY;

    active-background: @select;
    urgent-background: @red;
    urgent-foreground: @background;
    selected-background: @active-background;
    selected-urgent-background: @urgent-background;
    selected-active-background: @active-background;
    bordercolor: @select;
}
EOF
}

write_wlogout_colors() {
    local output="$config_home/wlogout/colors.css"

    mkdir -p -- "$(dirname "$output")"
    cat > "$output" <<EOF
/* Generated by theme-switch. Edit theme-switcher/themes.tsv instead. */
@define-color blur_background $BACKGROUND;
@define-color blur_background8 $BACKGROUND2;
@define-color background $BACKGROUND;
@define-color foreground $FOREGROUND;
@define-color on_primary $SELECT;
@define-color shadow #000000;
@define-color primary $BLUE;
@define-color secondary $PURPLE;
@define-color tertiary $YELLOW;
@define-color error $RED;
@define-color surface $BACKGROUND;
@define-color surface_container $BACKGROUND2;
@define-color on_surface $FOREGROUND;
@define-color outline $GRAY;
@define-color source_color $ORANGE;
EOF
}

write_ghostty_theme() {
    local output="$config_home/ghostty/theme.conf"
    local background_hex="${BACKGROUND#\#}"

    mkdir -p -- "$(dirname "$output")"
    cat > "$output" <<EOF
# Generated by theme-switch. Edit theme-switcher/themes.tsv instead.
theme = $GHOSTTY_THEME
background = $background_hex
EOF
}

write_state() {
    mkdir -p -- "$(dirname "$current_file")"
    printf '%s\n' "$THEME_NAME" > "$current_file"

    if [[ "$write_nvim_state" -eq 1 ]]; then
        mkdir -p -- "$(dirname "$nvim_state_file")"
        printf '%s\n' "$NVIM_THEME" > "$nvim_state_file"
    fi
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --list)
            list_only=1
            ;;
        --current)
            use_current=1
            ;;
        --quiet)
            quiet=1
            ;;
        --no-nvim-state)
            write_nvim_state=0
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
        *)
            theme_name="$1"
            ;;
    esac
    shift
done

if [[ ! -f "$themes_file" ]]; then
    echo "Theme file not found: $themes_file" >&2
    exit 1
fi

if [[ "$list_only" -eq 1 ]]; then
    theme_names
    exit 0
fi

if [[ "$use_current" -eq 1 ]]; then
    if [[ -s "$current_file" ]]; then
        theme_name="$(sed -n '1p' "$current_file")"
    else
        theme_name="ayu"
    fi
fi

if [[ -z "$theme_name" ]]; then
    theme_name="$(pick_theme)"
fi

if [[ -z "${theme_name// }" ]]; then
    exit 0
fi

if ! load_theme "$theme_name"; then
    echo "Unknown theme: $theme_name" >&2
    echo "Available themes:" >&2
    theme_names >&2
    exit 1
fi

write_gtk_colors
write_rofi_colors
write_wlogout_colors
write_ghostty_theme
write_state

log "Theme applied: $THEME_NAME"
