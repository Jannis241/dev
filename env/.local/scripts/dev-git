#!/usr/bin/env bash
set -euo pipefail

get-dependencies
# Prüfen, ob DEV_ENV gesetzt ist
if [ -z "$DEV_ENV" ]; then
    echo "❌ DEV_ENV ist nicht gesetzt!"
    exit 1
fi

# Wechsle ins DEV_ENV Verzeichnis
pushd "$DEV_ENV" > /dev/null || exit 1

# Git-Änderungen committen und pushen
git add -A
if git diff --cached --quiet; then
    echo "ℹ️ Keine Änderungen für DEV_ENV gefunden."
    popd > /dev/null
    exit 0
fi

git commit -m "chore(dev): automated snapshot $(date +%F)"
git pull --rebase --autostash
git push

# Zurück wechseln
popd > /dev/null
