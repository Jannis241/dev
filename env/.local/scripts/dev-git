#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${DEV_ENV:-}" ]]; then
    echo "DEV_ENV ist nicht gesetzt." >&2
    exit 1
fi

get-dependencies

pushd "$DEV_ENV" > /dev/null || exit 1

git add -A
if git diff --cached --quiet; then
    echo "Keine Aenderungen fuer DEV_ENV gefunden."
    popd > /dev/null
    exit 0
fi

git commit -m "chore(dev): automated snapshot $(date +%F)"
git pull --rebase --autostash
git push

popd > /dev/null
