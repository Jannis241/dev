#!/bin/bash
set -euo pipefail

# Abbruch, wenn keine Commit-Message übergeben wurde
if [ -z "$1" ]; then
  echo "Fehler: Bitte eine Commit-Message angeben!"
  echo "Usage: cmt \"Deine Nachricht\""
  exit 1
fi

# Git Befehle
git add -A
if git diff --cached --quiet; then
  echo "Keine Änderungen zum Committen gefunden."
  exit 0
fi

git commit -m "$1"
git pull --rebase --autostash
git push
