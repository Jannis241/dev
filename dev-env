#!/usr/bin/env bash

set -u

dry_run=0

if [ -z "$XDG_CONFIG_HOME" ]; then
    echo "no xdg config home"
    echo "using ~/.config"
    XDG_CONFIG_HOME="$HOME/.config"
fi


if [ -z "$DEV_ENV" ]; then
    echo "env var DEV_ENV needs to be present"
    exit 1
fi

if [[ ${1:-} == "--dry" ]]; then
    dry_run=1
fi

log() {
    if [[ $dry_run -eq 1 ]]; then
        echo "[DRY_RUN]: $1"
    else
        echo "$1"
    fi
}

log "env: $DEV_ENV"
log "config: $XDG_CONFIG_HOME"
log "home: $HOME"

update_files() {
    local source_dir="$1"
    local target_root="$2"

    if [[ ! -d "$source_dir" ]]; then
        log "skip missing source dir: $source_dir"
        return
    fi

    log "copying over files from: $source_dir"
    pushd "$source_dir" &> /dev/null
    (
        while IFS= read -r -d '' entry; do
            local_name="${entry#./}"
            destination="${target_root%/}/$local_name"

            log "    removing: rm -rf $destination"

            if [[ $dry_run -eq 0 ]]; then
                rm -rf -- "$destination"
            fi

            log "    copying env: cp -a $entry $target_root/"
            if [[ $dry_run -eq 0 ]]; then
                cp -a -- "$entry" "$target_root/"
            fi
        done < <(find . -mindepth 1 -maxdepth 1 -print0)
    )
    popd &> /dev/null
}

copy_file() {
    local source_file="$1"
    local destination_file="$2"

    if [[ ! -f "$source_file" ]]; then
        log "skip missing file: $source_file"
        return
    fi

    log "removing: $destination_file"
    if [[ $dry_run -eq 0 ]]; then
        rm -f -- "$destination_file"
    fi

    log "copying: $source_file to $destination_file"
    if [[ $dry_run -eq 0 ]]; then
        cp -f -- "$source_file" "$destination_file"
    fi
}


update_files "$DEV_ENV/env/.config" "$XDG_CONFIG_HOME"
update_files "$DEV_ENV/env/.local" "$HOME/.local"

copy_file "$DEV_ENV/env/.zsh_profile" "$HOME/.zsh_profile"
copy_file "$DEV_ENV/env/.zshrc" "$HOME/.zshrc"
copy_file "$DEV_ENV/env/.fzf_config" "$HOME/.fzf_config"
copy_file "$DEV_ENV/env/.profile" "$HOME/.profile"
copy_file "$DEV_ENV/dev-env" "$HOME/.local/scripts/dev-env"
copy_file "$DEV_ENV/wallpaper.png" "$HOME/wallpaper.png"


log "ensuring local bin dir exists"
if [[ $dry_run -eq 0 ]]; then
    mkdir -p "$HOME/.local/bin"
fi

if [[ $dry_run -eq 0 ]] && command -v hyprctl >/dev/null 2>&1; then
    hyprctl reload >/dev/null 2>&1 || true
fi

