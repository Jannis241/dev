#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export DEV_ENV="${DEV_ENV:-$repo_dir}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

dry_run=0
yes=0
install_packages=1
install_aur=1
install_flatpak=1
apply_dotfiles=1
enable_services=1
set_login_shell=1

usage() {
    cat <<'EOF'
Usage: ./dotfiles_setup [options]

Options:
  --dry-run        Print actions without changing the system
  -y, --yes        Pass noninteractive confirmation flags to package managers
  --no-packages   Skip pacman package installation
  --no-aur        Skip paru bootstrap and AUR packages
  --no-flatpak    Skip Flathub setup and Flatpak packages
  --no-dotfiles   Skip copying dotfiles with ./dev-env
  --no-services   Skip systemd service enablement
  --no-shell      Skip changing the login shell to zsh
  -h, --help      Show this help
EOF
}

log() {
    printf '%s\n' "$*"
}

print_cmd() {
    printf '+'
    printf ' %q' "$@"
    printf '\n'
}

run() {
    print_cmd "$@"
    if [[ "$dry_run" -eq 0 ]]; then
        "$@"
    fi
}

run_xargs_file() {
    local file="$1"
    shift

    [[ -s "$file" ]] || return 0

    printf '+ xargs -r -a %q --' "$file"
    printf ' %q' "$@"
    printf '\n'

    if [[ "$dry_run" -eq 0 ]]; then
        xargs -r -a "$file" -- "$@"
    fi
}

require_arch() {
    if ! command -v pacman >/dev/null 2>&1; then
        log "pacman not found; this setup script expects Arch Linux."
        exit 1
    fi
}

install_pacman_list() {
    local file="$1"
    local cmd=(sudo pacman -S --needed)

    [[ -s "$file" ]] || return 0

    if [[ "$yes" -eq 1 ]]; then
        cmd+=(--noconfirm)
    fi

    run_xargs_file "$file" "${cmd[@]}"
}

ensure_paru() {
    local build_dir
    local makepkg_cmd=(makepkg -si)

    if command -v paru >/dev/null 2>&1; then
        return 0
    fi

    if [[ "$dry_run" -eq 0 ]] && { ! command -v git >/dev/null 2>&1 || ! command -v makepkg >/dev/null 2>&1; }; then
        log "git and makepkg are required to bootstrap paru."
        exit 1
    fi

    if [[ "$yes" -eq 1 ]]; then
        makepkg_cmd+=(--noconfirm)
    fi

    if [[ "$dry_run" -eq 1 ]]; then
        build_dir="/tmp/dotfiles-setup-paru"
    else
        build_dir="$(mktemp -d)"
    fi

    run git clone https://aur.archlinux.org/paru.git "$build_dir/paru"

    printf '+ cd %q\n' "$build_dir/paru"
    print_cmd "${makepkg_cmd[@]}"
    if [[ "$dry_run" -eq 0 ]]; then
        (
            cd "$build_dir/paru"
            "${makepkg_cmd[@]}"
        )
        rm -rf -- "$build_dir"
    fi
}

install_aur_list() {
    local file="$1"
    local cmd=(paru -S --needed)

    [[ -s "$file" ]] || return 0

    if [[ "$yes" -eq 1 ]]; then
        cmd+=(--noconfirm)
    fi

    run_xargs_file "$file" "${cmd[@]}"
}

install_flatpak_list() {
    local file="$1"

    command -v flatpak >/dev/null 2>&1 || return 0

    run flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
    run_xargs_file "$file" flatpak install -y flathub
}

enable_service() {
    local service="$1"

    if systemctl list-unit-files "$service" >/dev/null 2>&1; then
        run sudo systemctl enable "$service"
    else
        log "skip missing service: $service"
    fi
}

configure_shell() {
    local user_name
    local zsh_bin

    zsh_bin="$(command -v zsh || true)"
    if [[ -z "$zsh_bin" ]]; then
        log "skip shell change: zsh not found"
        return
    fi

    user_name="${USER:-}"
    if [[ -z "$user_name" ]]; then
        user_name="$(id -un)"
    fi

    if [[ "${SHELL:-}" != "$zsh_bin" ]]; then
        run chsh -s "$zsh_bin" "$user_name"
    fi
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run|--dry)
            dry_run=1
            ;;
        -y|--yes)
            yes=1
            ;;
        --no-packages)
            install_packages=0
            ;;
        --no-aur)
            install_aur=0
            ;;
        --no-flatpak)
            install_flatpak=0
            ;;
        --no-dotfiles)
            apply_dotfiles=0
            ;;
        --no-services)
            enable_services=0
            ;;
        --no-shell)
            set_login_shell=0
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            log "Unknown option: $1"
            usage
            exit 2
            ;;
    esac
    shift
done

cd "$repo_dir"
log "repo: $repo_dir"
log "DEV_ENV: $DEV_ENV"
log "XDG_CONFIG_HOME: $XDG_CONFIG_HOME"

if [[ "$install_packages" -eq 1 ]]; then
    require_arch
    install_pacman_list "$repo_dir/dependencies/base.txt"
    install_pacman_list "$repo_dir/dependencies/desktop.txt"
    install_pacman_list "$repo_dir/dependencies/dev.txt"
    install_pacman_list "$repo_dir/dependencies/fonts.txt"
    install_pacman_list "$repo_dir/dependencies/apps.txt"
fi

if [[ "$install_aur" -eq 1 ]]; then
    ensure_paru
    install_aur_list "$repo_dir/dependencies/aur.txt"
fi

if [[ "$install_flatpak" -eq 1 ]]; then
    install_flatpak_list "$repo_dir/dependencies/flatpak.txt"
fi

if [[ "$set_login_shell" -eq 1 ]]; then
    configure_shell
fi

if [[ "$apply_dotfiles" -eq 1 ]]; then
    if [[ "$dry_run" -eq 1 ]]; then
        print_cmd "$repo_dir/dev-env" --dry
        "$repo_dir/dev-env" --dry
    else
        run "$repo_dir/dev-env"
    fi
fi

if [[ "$enable_services" -eq 1 ]]; then
    enable_service NetworkManager.service
    enable_service sddm.service
fi

log "Done. Review env/.config/hypr/custom_settings.conf for machine-specific Hyprland settings."
